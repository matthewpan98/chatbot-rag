# Copia questo file in .env e completa i valori

# Modello da usare: openai (serve OPENAI_API_KEY) oppure ollama (gratis, in locale)
LLM_PROVIDER=openai

# Chiave OpenAI (solo se LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key

# Opzionali: modelli specifici (se vuoti si usano quelli predefiniti del provider)
# openai -> gpt-4o-mini + text-embedding-3-small
# ollama -> llama3.2:3b + nomic-embed-text
LLM_MODEL=
EMBEDDING_MODEL=

# Opzionale: indirizzo di Ollama (in Docker punta all'Ollama installato sul computer)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Opzionali: tracciamento delle chiamate con LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Opzionale: cartella dei documenti da caricare (default backend-py/demo_data)
# DATA_DIR=
